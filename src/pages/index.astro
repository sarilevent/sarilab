---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchCard from "../components/ResearchCard.astro";
import { site } from "../data/site";
---

<BaseLayout title={`${site.name} | ${site.institution}`} description={site.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Computational biophysics · AI · Experiments</p>
        <h1>Understanding molecular origins of neurodegenerative diseases</h1>
        <p class="hero-lede">
          We combine AI and physics-based modeling, molecular simulations,
          and biophysical/biochemical experiments to uncover the molecular
          mechanisms, transition states, and critical seed structures that
          drive neurodegenerative protein aggregation.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/research">Explore our research</a>
          <a class="button secondary" href="/join">Join the lab</a>
        </div>
      </div>

      <div class="hero-visual" aria-label="Abstract molecular visualization">
        <div class="orb orb-a"></div>
        <div class="orb orb-b"></div>
        <div class="orb orb-c"></div>
        <div class="orb orb-d"></div>
        <div class="bond bond-1"></div>
        <div class="bond bond-2"></div>
        <div class="bond bond-3"></div>
        <div class="visual-label">
          <span>MOLECULAR</span>
          <strong>MECHANISMS</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container section-heading">
      <div>
        <p class="eyebrow">Research directions</p>
        <h2>From molecular mechanism to molecular design.</h2>
      </div>
      <p>
        Our work connects physics-based simulation with modern AI methods
        and targeted experiments.
      </p>
    </div>

    <div class="container research-grid">
      <ResearchCard number="01" title="Tau, Amyloid-β & α-Synuclein"
        text="Molecular mechanisms of nucleation, oligomerization, fibril formation, and disease-associated structural polymorphism." />
      <ResearchCard number="02" title="Molecular Dynamics"
        text="Atomistic MD, enhanced sampling, free-energy methods, and conformational ensemble analysis." />
      <ResearchCard number="03" title="AI Protein & Ligand Design"
        text="AI-guided design of proteins and peptides that recognize or modulate disease-relevant molecular states." />
      <ResearchCard number="04" title="Experimental Validation"
        text="Biochemical and biophysical assays to test computational predictions and designed molecules." />
    </div>
  </section>

  <section class="section contrast">
    <div class="container split">
      <div>
        <p class="eyebrow">Our approach</p>
        <h2>Physics + artificial intelligence + experiment</h2>
      </div>
      <div class="stack">
        <p>
          Protein aggregation is a multiscale problem. We study it by combining
          detailed molecular models with computational design and experiments.
        </p>
        <p>
          Our goal is not only to describe aggregate structures, but to identify
          the transient molecular states and interactions that initiate disease-relevant assembly.
        </p>
        <a class="text-link" href="/research">Read about our research →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta">
      <p class="eyebrow">Opportunities</p>
      <h2>Interested in joining the Sari Lab?</h2>
      <p>
        We welcome inquiries from postdoctoral researchers, graduate students,
        undergraduates, and collaborators interested in computational and experimental biophysics.
      </p>
      <a class="button primary" href="/join">View opportunities</a>
    </div>
  </section>
</BaseLayout>
