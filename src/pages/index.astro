---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchCard from "../components/ResearchCard.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`${site.name} | ${site.institution}`}
  description={site.description}
>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="container hero-grid">

      <!-- LEFT SIDE -->
      <div class="hero-copy">

        <p class="eyebrow">
          Computational Biophysics · AI · Experiments
        </p>

        <h1>
          Understanding the molecular origins of neurodegenerative diseases
        </h1>

        <p class="hero-lede">
          We combine AI and physics-based modeling, molecular simulations,
          and biophysical/biochemical experiments to uncover the molecular
          mechanisms, transition states, and critical seed structures that
          drive neurodegenerative protein aggregation.
        </p>

        <div class="hero-actions">

          <a
            class="button primary"
            href="/research"
          >
            Explore our research
          </a>

          <a
            class="button secondary"
            href="/join"
          >
            Join the lab
          </a>

        </div>

      </div>


      <!-- RIGHT SIDE RESEARCH FIGURE -->
      <div class="hero-visual">

        <img
          src="/images/sari-lab-research.png"
          alt="Sari Lab research overview showing amyloid formation mechanisms, AI binder designs for amyloids, RNA in amyloid formation, and membrane fusion mechanisms in neurotransmitter release"
          class="hero-research-image"
        />

      </div>

    </div>
  </section>


  <!-- RESEARCH DIRECTIONS -->
  <section class="section">

    <div class="container section-heading">

      <div>

        <p class="eyebrow">
          Research directions
        </p>

        <h2>
          From molecular mechanisms to molecular design.
        </h2>

      </div>

      <p>
        Our work connects physics-based molecular simulations,
        modern AI methods, and targeted biochemical and
        biophysical experiments.
      </p>

    </div>


    <div class="container research-grid">

      <ResearchCard
        number="01"
        title="Amyloid Formation Mechanisms"
        text="We investigate the molecular events that drive nucleation, oligomerization, fibril formation, and disease-associated structural polymorphism in tau, amyloid-β, α-synuclein, and related amyloid-forming proteins."
      />

      <ResearchCard
        number="02"
        title="AI Binder Designs for Amyloids"
        text="We use AI-guided protein, peptide, and ligand design to develop binders that recognize disease-relevant amyloid structures for potential diagnostic and therapeutic applications."
      />

      <ResearchCard
        number="03"
        title="RNA in Amyloid Formation"
        text="We investigate how RNA interacts with intrinsically disordered and amyloid-forming proteins and how these interactions influence aggregation pathways and fibril formation."
      />

      <ResearchCard
        number="04"
        title="Membrane Fusion & Neurotransmitter Release"
        text="We study the molecular mechanisms of synaptic membrane fusion and the protein interactions that control neurotransmitter release."
      />

    </div>

  </section>


  <!-- APPROACH -->
  <section class="section contrast">

    <div class="container split">

      <div>

        <p class="eyebrow">
          Our approach
        </p>

        <h2>
          Physics + artificial intelligence + experiment
        </h2>

      </div>


      <div class="stack">

        <p>
          Protein aggregation and other complex biological processes
          involve dynamic molecular systems that cannot be understood
          from a single static structure.
        </p>

        <p>
          We combine atomistic molecular dynamics simulations,
          enhanced sampling, free-energy calculations, AI-based
          molecular design, and experimental validation to characterize
          transient molecular states and interactions.
        </p>

        <p>
          Our goal is to uncover fundamental molecular mechanisms
          and translate these insights into new diagnostic and
          therapeutic strategies for neurodegenerative diseases.
        </p>

        <a
          class="text-link"
          href="/research"
        >
          Read about our research →
        </a>

      </div>

    </div>

  </section>


  <!-- JOIN LAB -->
  <section class="section">

    <div class="container cta">

      <p class="eyebrow">
        Opportunities
      </p>

      <h2>
        Interested in joining the Sari Lab?
      </h2>

      <p>
        We welcome inquiries from postdoctoral researchers,
        graduate students, undergraduate students, and collaborators
        interested in computational and experimental biophysics,
        protein aggregation, molecular simulation, and AI-based
        molecular design.
      </p>

      <a
        class="button primary"
        href="/join"
      >
        View opportunities
      </a>

    </div>

  </section>


  <!-- HOMEPAGE-SPECIFIC STYLES -->
  <style>

    /* =====================================================
       HERO
       ===================================================== */

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: center;
    }


    .hero-copy {
      min-width: 0;
    }


    .hero-copy h1 {
      max-width: 680px;
    }


    .hero-lede {
      max-width: 650px;
    }


    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 2rem;
    }


    /* =====================================================
       RIGHT-SIDE RESEARCH IMAGE
       ===================================================== */

    .hero-visual {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
    }


    .hero-research-image {
      display: block;

      width: 100%;
      max-width: 650px;

      height: auto;

      object-fit: contain;

      border-radius: 22px;

      background: white;

      box-shadow:
        0 20px 45px rgba(20, 45, 90, 0.10),
        0 4px 12px rgba(20, 45, 90, 0.06);
    }


    /* =====================================================
       TABLET
       ===================================================== */

    @media (max-width: 1000px) {

      .hero-grid {
        gap: 2rem;
      }

      .hero-research-image {
        max-width: 550px;
      }

    }


    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 800px) {

      .hero-grid {
        grid-template-columns: 1fr;
      }


      .hero-copy {
        text-align: center;
      }


      .hero-copy h1,
      .hero-lede {
        margin-left: auto;
        margin-right: auto;
      }


      .hero-actions {
        justify-content: center;
      }


      .hero-visual {
        margin-top: 1.5rem;
      }


      .hero-research-image {
        width: 100%;
        max-width: 600px;
      }

    }


    /* =====================================================
       SMALL MOBILE
       ===================================================== */

    @media (max-width: 500px) {

      .hero-actions {
        flex-direction: column;
        align-items: center;
      }


      .hero-actions .button {
        width: 100%;
        max-width: 300px;
      }


      .hero-research-image {
        border-radius: 14px;
      }

    }

  </style>

</BaseLayout>
