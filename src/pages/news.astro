---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

const news = [
  {
    date: "September 2026",
    title: "Sari Lab launches at the University of Houston",
    text: "Our new laboratory is beginning work at the interface of molecular simulation, AI-guided molecular design, and experimental biophysics."
  },
  {
    date: "2026",
    title: "We are recruiting",
    text: "Please see the Join Us page for current and upcoming opportunities."
  }
];
---

<BaseLayout title="News | Sari Lab">
  <PageHero eyebrow="News" title="Lab updates"

  <section class="section">
    <div class="container news-list">
      {news.map((item) => (
        <article class="news-item">
          <p class="news-date">{item.date}</p>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
