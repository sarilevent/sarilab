---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";

const news = [
  {
    date: "September 25th, 2026",
    title: "Welcome the first members of the Sari Lab!",
    text: [
      "Ilayda Engin has joined the lab as our first Ph.D. student, and Sara Laroussi has joined as an undergraduate researcher.",

      "Ilayda received her B.S. in Biology from Hacettepe University and her M.Sc. in Biotechnology from Ankara University in Turkey. Her master’s research focused on the development of monoclonal and chimeric antibodies targeting the glutamine transporter ASCT2 and investigating their effects on tumor cell growth. Her work has resulted in scientific publications.",

      "Sara is an undergraduate Biochemistry student pursuing her bachelor’s degree in Biochemical and Biophysical Sciences. She previously earned an Associate of Science (A.S.) degree from Lone Star College with a 4.0 GPA.",

      "Welcome aboard, Ilayda and Sara! We are very happy to have you as the first members of the Sari Lab.",
    ]
  },

  {
    date: "September 2026",
    title: "Sari Lab launches at the University of Houston",
    text: "Our new laboratory is beginning work at the interface of molecular simulation, AI-guided molecular design, and experimental biophysics."
  },

  {
    date: "2026",
    title: "We are recruiting",
    text: "Please see the Join Us page for current and upcoming opportunities."
  }
];
---

<BaseLayout title="News | Sari Lab">
  <PageHero eyebrow="News" title="Lab updates" />

  <section class="section">
    <div class="container news-list">

      {news.map((item) => (
        <article class="news-item">

          <p class="news-date">{item.date}</p>

          <h2>{item.title}</h2>

          {Array.isArray(item.text) ? (
            item.text.map((paragraph) => (
              <p>{paragraph}</p>
            ))
          ) : (
            <p>{item.text}</p>
          )}

        </article>
      ))}

    </div>
  </section>
</BaseLayout>
